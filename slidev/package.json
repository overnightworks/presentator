{
  "name": "slidev-addon-presentator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Slidev addon of the co-presenter",
  "keywords": [
    "slidev-addon",
    "slidev"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^24 || ^26",
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "build:example": "slidev build ../examples/hello-deck/slides.md --out dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-apple-basic": "0.25.1",
    "@slidev/theme-bricks": "0.25.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/theme-seriph": "0.25.0",
    "@slidev/theme-shibainu": "0.25.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "playwright-chromium": "1.64.1",
    "slidev-addon-presentator": "link:.",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "image-size": "^2.0.3",
      "@hono/node-server": "^2.1.3",
      "@modelcontextprotocol/node": "2.1.0",
      "katex": "^0.18.2",
      "minimatch": "^11.0.1",
      "@comark/markdown-it>markdown-it": "^14.1.0"
    }
  }
}
