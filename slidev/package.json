{
  "name": "slidev-addon-presentator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Slidev addon of the co-presenter",
  "keywords": [
    "slidev-addon",
    "slidev"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24 || ^26",
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "rm -rf ../reports/slidev-browser-coverage && OVERLAY_INSTRUMENTED=1 vitest run --coverage",
    "coverage:merge": "node scripts/merge-coverage.ts",
    "build:example": "slidev build ../examples/hello-deck/slides.md --out dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@slidev/cli": "53.1.0",
    "@slidev/theme-apple-basic": "0.25.1",
    "@slidev/theme-bricks": "0.25.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/theme-seriph": "0.25.0",
    "@slidev/theme-shibainu": "0.25.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-lib-source-maps": "4.0.4",
    "@types/istanbul-reports": "3.0.4",
    "@vitest/coverage-istanbul": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "magic-string": "0.30.21",
    "overnightworks-speech-browser": "https://github.com/overnightworks/speech/releases/download/v0.22.0/overnightworks-speech-browser-0.22.0.tgz",
    "playwright-chromium": "1.65.0",
    "slidev-addon-presentator": "link:.",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
