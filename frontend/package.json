{
	"name": "presentator-lobby",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run --coverage",
		"drive": "playwright test",
		"generate:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/types.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"openapi-typescript": "7.13.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"overnightworks-appkit": "https://github.com/overnightworks/appkit/releases/download/v0.11.0/overnightworks-appkit-0.11.0.tgz"
	}
}
